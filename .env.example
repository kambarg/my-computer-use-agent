# Copy to .env. Compose interpolates this file automatically.

# Required for a real agent (Usage Case 1). The fake worker used in
# pytest does not need a key.
ANTHROPIC_API_KEY=

# Required when using the production overlay (`compose.prod.yaml`).
# Local Compose defaults to `app` if this is unset.
# Changing it after the first Postgres boot has no effect until the
# `pgdata` volume is removed.
POSTGRES_PASSWORD=

# Safety cap on concurrent worker containers (not a fixed pool of 2).
# MAX_WORKERS=8

# Local Compose sets ENABLE_DOCS=1 (Swagger at /docs).
# Production Compose sets ENABLE_DOCS=0.
# ENABLE_DOCS=1

# Optional. Pin to a digest for reproducible worker images.
# WORKER_BASE_IMAGE=ghcr.io/anthropics/anthropic-quickstarts:computer-use-demo-latest
